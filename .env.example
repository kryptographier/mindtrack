# =========================================================
# PUBLIC FRONTEND CONFIGURATION
# Anything in this section is bundled into the Vite build and
# shipped to GitHub Pages. Treat every value here as PUBLIC,
# even though it looks like a "key" or "credential" name.
# =========================================================

# Supabase project URL (public by design)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase anon/public key (safe to expose; RLS is the real boundary)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# =========================================================
# SERVER-ONLY SECRETS
# These must NEVER be committed, NEVER appear in a GitHub
# Actions log, and NEVER be referenced from any VITE_-prefixed
# variable or frontend code path. Set these only as:
#   - Supabase Edge Function secrets (`supabase secrets set`)
#   - GitHub Actions repository secrets (used only for CI steps
#     that talk to Supabase's Management API, never bundled)
# =========================================================

# Supabase service-role key. Full DB access, bypasses RLS.
# Used ONLY inside Edge Functions (admin actions, secret-code
# issuance/redemption). Never in frontend code, never logged.
SUPABASE_SERVICE_ROLE_KEY=

# Brevo transactional email API key, used as the Supabase
# custom-SMTP password. Server-side only (Supabase Auth SMTP
# settings), never referenced from frontend code.
BREVO_SMTP_API_KEY=

# The verified Brevo sender address (a plain inbox you control,
# no domain required). Used as the "From" address for OTP emails.
BREVO_SENDER_EMAIL=

# Application-level session configuration (server-enforced;
# see docs/architecture.md section 5 for why this exists on Free tier)
DIARY_IDLE_TIMEOUT_MINUTES=30
DIARY_MAX_LIFETIME_HOURS=12
CHAT_IDLE_TIMEOUT_MINUTES=10
CHAT_MAX_LIFETIME_MINUTES=30

# Shared secret gating the `cleanup` Edge Function (see
# supabase/functions/cleanup and .github/workflows/cleanup.yml).
# Set as BOTH a Supabase Edge Function secret
# (`supabase secrets set CLEANUP_SECRET=...`) AND a GitHub
# Actions repository secret of the same name and value. Generate
# with something like `openssl rand -hex 32`. Never reused for
# anything else, never logged.
CLEANUP_SECRET=
